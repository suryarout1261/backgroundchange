---
import Layout from '../layouts/Layout.astro';
import { EditorApp } from '../components/editor/EditorApp';
import FaqSection from '../components/FaqSection.astro';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Change Photo Background Online with Background Changer",
  "description": "Step-by-step tutorial on using Background Changer to remove background from image, pick solid colors or custom scenes, and download high-resolution photos.",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Upload Your Photo",
      "text": "Upload any JPG, JPEG, PNG, or WebP photo or headshot into the Background Changer online tool."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Automatic Background Removal",
      "text": "Our client-side AI background remover automatically detects the subject and removes the background in milliseconds."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Change Background Color or Upload Image",
      "text": "Select a solid color like white or blue, pick a custom HEX/RGB color, or upload your own custom background image."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": "Crop, Adjust & Download",
      "text": "Crop to standard passport or job application dimensions, fine-tune lighting with the photo editor online, and download your file."
    }
  ]
};
---

<Layout
  title="Background Changer – Free Online Image & Photo Background Changer"
  description="Background Changer is a fast, free photo background editor and background remover. Change image background to white, blue, or custom colors for passport and job application photos."
  canonicalPath="/"
>
  <!-- Editor & Interactive Upload Zone -->
  <section class="w-full py-6 md:py-10" aria-label="Background Changer Tool">
    <EditorApp client:load />
  </section>

  <!-- Key Application Use Cases & Value Props -->
  <section class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          All-in-One Photo Background Changer & Image Background Editor
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Whether you need a crisp <strong>white background photo</strong> for a resume, an official <strong>passport photo background</strong>, or a <strong>custom background color</strong> for online forms, our <strong>background changer online</strong> handles it in seconds.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Card 1 -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-blue-100 dark:bg-blue-950/80 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm mb-4">
              01
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
              Job Application Photo Background
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Format clean, professional headshots for resumes, CVs, LinkedIn profiles, and company directories. Easily <strong>change photo background</strong> to neutral white or a light <strong>blue background photo</strong> to match recruitment guidelines.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700/60 text-xs font-semibold text-blue-600 dark:text-blue-400">
            ✓ Standard 3:4 & 1:1 Aspect Ratios
          </div>
        </div>

        <!-- Card 2 -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm mb-4">
              02
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
              Passport & ID Photo Background Changer
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Create compliant 2×2 inch (600×600 px) US Passport, Visa, and national identity photos. Use our built-in face and eye alignment guides to position your portrait accurately and <strong>change background color</strong> instantly.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700/60 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            ✓ Built-in Passport Face Guides
          </div>
        </div>

        <!-- Card 3 -->
        <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700/60 flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-bold text-sm mb-4">
              03
            </div>
            <h3 class="text-base font-bold text-slate-900 dark:text-white mb-2">
              Private In-Browser Background Remover
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              Our <strong>online background changer</strong> processes all images directly in your browser with WebAssembly AI. <strong>Remove background from photo</strong> files with 100% privacy—no cloud uploads, no logins, and no watermarks.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-200 dark:border-slate-700/60 text-xs font-semibold text-indigo-600 dark:text-indigo-400">
            ✓ Zero Server Storage • 100% Free
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works Summary with Step-by-Step Guide -->
  <section class="py-16 bg-slate-50 dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 mb-3 border border-blue-200 dark:border-blue-900">
          Easy 4-Step Process
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          How to Change Image Background in 4 Simple Steps
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-400">
          Learn how our <strong>photo background editor</strong> makes background replacement effortless.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-center">
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center mb-3 shadow-md shadow-blue-500/20">
            1
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">Upload Photo</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Drag and drop your JPG, PNG, or WebP portrait into the <strong>background changer online</strong>.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center mb-3 shadow-md shadow-blue-500/20">
            2
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">Remove Background</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Automated AI acts as a fast <strong>background remover</strong> to cleanly isolate your subject.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center mb-3 shadow-md shadow-blue-500/20">
            3
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">Pick Color or Image</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Choose solid white, passport blue, custom HEX colors, or upload your own custom scene backdrop.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col items-center">
          <div class="w-12 h-12 rounded-full bg-blue-600 text-white font-bold text-sm flex items-center justify-center mb-3 shadow-md shadow-blue-500/20">
            4
          </div>
          <h3 class="font-bold text-sm text-slate-900 dark:text-white mb-1">Download Instantly</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Export directly in high resolution as JPG, transparent PNG, or WebP with custom size controls.
          </p>
        </div>
      </div>

      <!-- Quick Internal Links CTA -->
      <div class="mt-10 text-center flex flex-wrap items-center justify-center gap-4 text-xs font-semibold">
        <a href="/how-it-works" class="text-blue-600 dark:text-blue-400 hover:underline">
          Read Detailed Passport & Photo Guidelines &rarr;
        </a>
        <span class="text-slate-300 dark:text-slate-700">•</span>
        <a href="/about" class="text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:underline">
          Learn More About Our Utility &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section with Schema.org FAQPage -->
  <FaqSection />

  <!-- HowTo Schema Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
</Layout>

