---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us – Background Changer Support"
  description="Get in touch with the Background Changer support team for questions, feedback, or feature requests."
  canonicalPath="/contact"
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="text-center max-w-xl mx-auto mb-10">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 mb-3 border border-blue-200 dark:border-blue-900">
        Support & Inquiries
      </span>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Contact Us
      </h1>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
        Have questions about photo formatting, suggestions for new features, or technical questions? We're here to help.
      </p>
    </div>

    <!-- Contact Info Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg flex-shrink-0">
          ✉️
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">
            Email Support
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-1.5">
            General queries & feedback:
          </p>
          <a
            href="mailto:suryaprasadrout1261@gmail.com"
            class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline break-all"
          >
            suryaprasadrout1261@gmail.com
          </a>
        </div>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex items-start gap-3.5">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg flex-shrink-0">
          ⚡
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-1">
            Response Time
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
            Our technical team typically responds to all inquiries within 24 to 48 business hours.
          </p>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm">
      <h2 class="text-lg font-bold text-slate-900 dark:text-white mb-4">
        Send Us a Message
      </h2>
      <form
        class="space-y-4"
        onsubmit="event.preventDefault(); alert('Thank you for reaching out! We have received your message and will get back to you shortly.'); this.reset();"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Your Name
            </label>
            <input
              type="text"
              required
              placeholder="John Doe"
              class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Email Address
            </label>
            <input
              type="email"
              required
              placeholder="you@example.com"
              class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Subject
          </label>
          <input
            type="text"
            required
            placeholder="Feedback, Bug Report, or Question"
            class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Message
          </label>
          <textarea
            required
            rows="4"
            placeholder="How can we help you?"
            class="w-full px-3.5 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm text-slate-900 dark:text-white outline-none focus:ring-2 focus:ring-blue-500 resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm shadow-md shadow-blue-500/20 transition-all cursor-pointer"
        >
          Send Message
        </button>
      </form>
    </div>
  </div>
</Layout>
